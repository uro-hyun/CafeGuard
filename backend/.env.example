# 서버 포트
PORT=5000

# MongoDB 연결 문자열
#  - 로컬: mongodb://127.0.0.1:27017/cafeguard
#  - Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cafeguard
MONGODB_URI=mongodb://127.0.0.1:27017/cafeguard

# 게이트보드 인증 키 (펌웨어의 DEVICE_KEY와 동일하게). 비워두면 인증 없이 허용
DEVICE_KEY=change-me

# 대시보드 접속 허용 Origin (쉼표 구분, 비우면 전체 허용)
CORS_ORIGIN=

# 지급보드 BLE 이름 접두어
TAG_PREFIX=CG-
