{
  // Ctrl+Shift+B → 백엔드(5000)와 대시보드(5173)를 각각 터미널에서 실행
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "CafeGuard 서버 실행",
      "dependsOn": ["backend", "frontend"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
